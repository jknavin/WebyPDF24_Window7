{
  "name": "webypdf",
  "productName": "WebyPDF",
  "version": "2.3.1",
  "description": "WebyPDF - professional offline PDF tools for Windows 7, 8 and 10 (Windows 7 edition)",
  "main": "main.js",
  "author": "WebyPDF",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "predist": "node scripts/prepare-ocr.js",
    "prepare-ocr": "node scripts/prepare-ocr.js"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "25.1.8",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1"
  },
  "build": {
    "appId": "com.webypdf.app",
    "productName": "WebyPDF",
    "files": [
      "main.js",
      "preload.js",
      "office-engine.js",
      "icon.png",
      "web/**/*",
      "package.json",
      "!web/vendor/ocr/**/*.part"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "WebyPDF-Win7-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "WebyPDF-Win7-Portable-${version}.${ext}"
    }
  }
}